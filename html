function show(id,on=true){$(id).classList.toggle("hidden",!on)}
function svgEl(tag,attrs={},text){let el=document.createElementNS(ns,tag);Object.entries(attrs).forEach(([k,v])=>el.setAttribute(k,v));if(text!==undefined)el.textContent=text;return el}
function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function nextAlive(i){for(let k=1;k<=players.length;k++){let j=(i+k)%players.length;if(players[j].lives>0)return j}return i}
function enableAnswer(on){$("answer").disabled=!on;$("submit").disabled=!on}
function positionFish(p,angle=0){fishPos={x:p.x,y:p.y};$("puffer").setAttribute("transform",`translate(${p.x} ${p.y}) rotate(${angle})`)}
function clearFlight(){flight=null;$("trail").setAttribute("d","");if(docks[turn])positionFish(docks[turn])}
function stop(){cancelAnimationFrame(raf);raf=0}
function chips(id,items){$(id).replaceChildren();items.forEach(t=>{let s=document.createElement("span");s.className="chip";s.textContent=t;$(id).append(s)})}
function buildCircle(){
 $("stations").replaceChildren();docks=[];stationEls=[];
 players.forEach((p,i)=>{
 const angle=-Math.PI/2+i*Math.PI*2/players.length;
 const x=450+320*Math.cos(angle),y=289+177*Math.sin(angle);
 docks.push({x,y:y-45});
 const g=svgEl("g",{class:"station",transform:`translate(${x} ${y})`});
 g.append(svgEl("title",{},p.name));
 g.append(svgEl("rect",{x:-77,y:-20,width:154,height:56,rx:13}));
 g.append(svgEl("text",{class:"teamname",x:0,y:2,"text-anchor":"middle"},p.name.length>18?p.name.slice(0,17)+"…":p.name));
 const stats=svgEl("text",{class:"stats",x:0,y:22,"text-anchor":"middle"});
 g.append(stats);$("stations").append(g);stationEls.push({g,stats});
 });
}
function roster(){
 $("roster").replaceChildren();
 players.forEach((p,i)=>{
 let d=document.createElement("div");d.className="teamrow"+(i===turn?" active":"")+(p.lives===0?" out":"");
 let a=document.createElement("div"),n=document.createElement("strong");n.className="teamname";n.textContent=p.name;a.append(n);
 let s=document.createElement("div");s.className="fine";s.textContent=p.passes+" accepted passes";a.append(s);
 let life=document.createElement("div");life.className="lives";life.textContent=p.lives?"♥ ".repeat(p.lives):"Out";life.setAttribute("aria-label",p.lives+" lives");
 d.append(a,life);$("roster").append(d);
 stationEls[i].g.setAttribute("class","station"+(i===turn?" active":"")+(p.lives===0?" out":""));
 stationEls[i].stats.textContent=p.lives?`${"♥ ".repeat(p.lives)} · ${p.passes} passes`:"ELIMINATED";
 });
 $("holder").textContent=players[turn].name+" holds the puffer";
}
function newRound(){
 stop();round++;used=new Set();usedKeys=new Set();history=[];lastText="";remaining=10000;
 if(!deck.length){deck=shuffle(pool);if(q&&deck.length>1&&deck[0].id===q.id)[deck[0],deck[1]]=[deck[1],deck[0]]}
 q=deck.shift();phase="ready";clearFlight();
 $("effects").replaceChildren();$("puffer").style.visibility="visible";$("puffer").classList.remove("shaking");$("inflate").setAttribute("transform","scale(1)");
 $("roundLabel").textContent="Round "+round;$("unitLabel").textContent="Unit "+q.unit;
 $("prompt").textContent=q.prompt;$("hint").textContent=q.hint;
 $("centerStatus").textContent="Get ready";$("centerSub").textContent="Read the category. Then start.";
 $("answer").value="";$("message").textContent="";$("feedback").textContent="";
 $("used").textContent="No answers yet.";show("result",false);show("teacher",false);show("begin");
 $("pause").disabled=true;enableAnswer(false);roster();
}
function run(){
 phase="running";deadline=Date.now()+remaining;stop();show("teacher",false);$("pause").disabled=false;
 $("centerStatus").textContent="The fuse is live";$("centerSub").textContent="Think fast. Pass the puffer!";
 enableAnswer(true);$("answer").focus();raf=requestAnimationFrame(tick);
}
function tick(now){
 if(phase!=="running")return;
 let left=deadline-Date.now();
 if(left<=0){pop();return}
 let growth=1+Math.min(1,Math.max(0,1-left/10000))*.5;
 $("inflate").setAttribute("transform",`scale(${growth})`);
 $("puffer").classList.toggle("shaking",left<2200&&!flight);
 if(flight){
 const t=Math.min(1,(now-flight.start)/flight.duration),u=1-t;
 let x=u*u*flight.from.x+2*u*t*flight.control.x+t*t*flight.to.x;
 let y=u*u*flight.from.y+2*u*t*flight.control.y+t*t*flight.to.y;
 positionFish({x,y},Math.sin(t*Math.PI)*12);
 if(t>=1){clearFlight();enableAnswer(true);$("answer").focus();$("centerStatus").textContent="The fuse is live"}
 }
 raf=requestAnimationFrame(tick);
}
function startFlight(from){
 let to=docks[turn];
 if(reduced()){clearFlight();enableAnswer(true);$("answer").focus();return}
 const control={x:(from.x+to.x)/2,y:(from.y+to.y)/2-65};
 flight={from,to,control,start:performance.now(),duration:420};
 $("trail").setAttribute("d",`M${from.x} ${from.y} Q${control.x} ${control.y} ${to.x} ${to.y}`);
 $("centerStatus").textContent="Pass the puffer!";enableAnswer(false);
}
function pause(){
 if(phase!=="running")return;
 if(Date.now()>=deadline){pop();return}
 remaining=deadline-Date.now();phase="paused";stop();clearFlight();enableAnswer(false);
 $("centerStatus").textContent="Paused";$("centerSub").textContent="The fuse is stopped.";
 $("puffer").classList.remove("shaking");
 $("ruling").value=$("answer").value||lastText;$("reviewMessage").textContent="";show("teacher");$("pause").disabled=true;
}
function duplicate(key,idx){return usedKeys.has(key)||(idx>=0&&used.has(idx))}
function accept(text,idx,teacher=false){
 if(phase!=="running"&&phase!=="paused")return;
 if(phase==="running"&&Date.now()>=deadline){pop();return}
 let key=norm(text);
 if(!key)return;
 if(duplicate(key,idx)){if(teacher)$("reviewMessage").textContent="Already used this round, including as a synonym.";return}
 usedKeys.add(key);if(idx>=0){used.add(idx);q.answers[idx].keys.forEach(k=>usedKeys.add(k))}
 let label=idx>=0?q.answers[idx].name:text.trim(),previous=players[turn].name,from={...fishPos};
 history.push(label+(teacher?" · teacher accepted":""));players[turn].passes++;turn=nextAlive(turn);
 $("answer").value="";lastText="";$("message").textContent="";
 $("feedback").textContent=previous+": "+label+" ✓ → "+players[turn].name;
 chips("used",history);roster();
 if(teacher){clearFlight();run()}else startFlight(from);
}
function submit(e){
 e.preventDefault();if(phase!=="running"||flight)return;
 if(Date.now()>=deadline){pop();return}
 let text=$("answer").value.trim(),key=norm(text);
 if(!key){$("message").textContent="Enter an answer to pass.";return}
 lastText=text;let idx=q.answers.findIndex(a=>a.keys.includes(key));
 if(duplicate(key,idx)){$("message").textContent="Already used! Try another answer. The fuse is still live.";return}
 if(idx<0){$("message").textContent="Not recognized. Try another answer or pause for a teacher ruling. The fuse is still live.";return}
 accept(text,idx);
}
function burst(){
 const p=docks[turn];$("effects").replaceChildren();$("puffer").style.visibility="hidden";
 if(!reduced()){
 for(let i=0;i<24;i++){
 const angle=i*Math.PI*2/24,dist=60+(i%5)*17;
 let bubble=svgEl("circle",{cx:p.x,cy:p.y,r:5+i%5,fill:i%3===0?"#ffdf8d":"#a1f5ee","fill-opacity":.8,stroke:"#eaffff","stroke-width":1,class:"bubble"});
 bubble.style.setProperty("--dx",Math.cos(angle)*dist+"px");bubble.style.setProperty("--dy",Math.sin(angle)*dist+"px");$("effects").append(bubble);
 }
 }
 $("effects").append(svgEl("text",{x:p.x,y:p.y+9,"text-anchor":"middle",class:"popword"},"POP!"));
}
function pop(){
 if(phase!=="running")return;
 stop();phase="popped";clearFlight();players[turn].lives--;enableAnswer(false);$("pause").disabled=true;
 $("puffer").classList.remove("shaking");burst();roster();
 const p=players[turn];$("centerStatus").textContent="Puffer popped!";$("centerSub").textContent="The holding team loses one life.";
 $("message").textContent="";$("feedback").textContent="";
 $("popTitle").textContent=p.name+(p.lives?" has "+p.lives+" "+(p.lives===1?"life":"lives")+" left.":" is out of this match.");
 $("note").textContent=q.note;
 chips("examples",q.answers.filter((a,i)=>!used.has(i)).slice(0,6).map(a=>a.name));
 if(!q.answers.some((a,i)=>!used.has(i)))$("examples").textContent="You found every answer in this category’s bank!";
 show("result");show("teacher",false);
 $("next").textContent=players.filter(p=>p.lives>0).length===1?"See the winner →":"Next round →";
}
function finish(){
 stop();phase="ended";show("play",false);show("end");
 const champion=players.find(p=>p.lives>0);$("winner").textContent=champion.name+" wins!";
 $("endNote").textContent=round+" rounds played. Each team: explain one new APES term you heard and why it fit the category.";
 $("endList").replaceChildren();
 [...players].sort((a,b)=>b.lives-a.lives||b.passes-a.passes).forEach(p=>{
 const d=document.createElement("div");d.className="teamrow";
 const n=document.createElement("strong");n.textContent=p.name;const s=document.createElement("span");s.textContent=p.lives+" lives · "+p.passes+" passes";d.append(n,s);$("endList").append(d);
 });
}
function back(){stop();phase="setup";flight=null;show("setup");show("play",false);show("end",false)}
$("bankCount").textContent=bank.length+" categories · all 9 APES units";
$("start").onclick=()=>{
 let names=$("names").value.split("\n").map(s=>s.trim()).filter(Boolean);
 if(names.length<2||names.length>8){$("setupError").textContent="Enter 2–8 players or teams, one per line.";return}
 if(names.some(n=>n.length>35)){$("setupError").textContent="Keep each name to 35 characters or fewer.";return}
 if(new Set(names.map(n=>n.toLowerCase())).size!==names.length){$("setupError").textContent="Give each team a different name.";return}
 $("setupError").textContent="";
 players=names.map(name=>({name,lives:+$("lives").value,passes:0}));
 pool=bank.filter(q=>$("unit").value==="all"||q.unit===+$("unit").value);
 deck=[];q=null;round=0;turn=Math.floor(Math.random()*players.length);
 show("setup",false);show("end",false);show("play");buildCircle();newRound();
};
$("begin").onclick=()=>{if(phase!=="ready")return;remaining=10000;show("begin",false);run()};
$("answerForm").onsubmit=submit;$("pause").onclick=pause;
$("resume").onclick=()=>{if(phase==="paused")run()};
$("approve").onclick=()=>{
 if(phase!=="paused")return;
 let text=$("ruling").value.trim(),key=norm(text);
 if(!key){$("reviewMessage").textContent="Enter the answer being approved.";return}
 accept(text,q.answers.findIndex(a=>a.keys.includes(key)),true);
};
$("next").onclick=()=>{
 if(phase!=="popped")return;
 if(players.filter(p=>p.lives>0).length===1){finish();return}
 turn=nextAlive(turn);newRound();
};
$("quit").onclick=back;$("again").onclick=back;
document.addEventListener("visibilitychange",()=>{if(document.hidden&&phase==="running")pause()});
</script>
</body>
</html>
