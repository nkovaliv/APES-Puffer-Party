<path d="M17 28 L24 43 L8 31Z"/><path d="M-12 29 L-17 44 L-24 24Z"/>
</g>
<ellipse rx="35" ry="32" fill="url(#fishColor)" stroke="#ffd885" stroke-width="1.5"/>
<g fill="#cc8e36" opacity=".7"><circle cx="-19" cy="-10" r="2.5"/><circle cx="-22" cy="7" r="2"/><circle cx="-9" cy="17" r="2"/><circle cx="0" cy="-20" r="2"/><circle cx="13" cy="23" r="2"/></g>
<ellipse cx="5" cy="-8" rx="8" ry="10" fill="white"/><ellipse cx="24" cy="-8" rx="8" ry="10" fill="white"/>
<ellipse cx="8" cy="-6" rx="3.5" ry="5" fill="#173445"/><ellipse cx="27" cy="-6" rx="3.5" ry="5" fill="#173445"/>
<ellipse cx="19" cy="12" rx="5" ry="6" fill="#76502f"/>
<path d="M-20 8 Q-36 18 -19 23" fill="#f6cf77"/>
</g></g>
</g>
<g id="effects"></g>
</svg>
</div>

<div class="grid">
<div class="card">
<div id="holder"></div>
<div id="prompt" class="prompt"></div>
<div id="hint" class="help"></div>
<form id="answerForm">
<label for="answer">Answer for the team holding the puffer</label>
<div class="row" style="flex-wrap:nowrap"><input id="answer" autocomplete="off" spellcheck="false" maxlength="100" placeholder="Type an answer…"><button id="submit">Pass →</button></div>
</form>
<div id="message" role="status" aria-live="polite"></div>
<div id="feedback" role="status" aria-live="polite"></div>
<button id="begin" class="full">Start the 10-second fuse</button>

<div id="result" class="review hidden">
<strong id="popTitle"></strong><p id="note" class="help"></p>
<div class="help">More answers that fit:</div><div id="examples"></div>
<button id="next" class="full">Next round →</button>
</div>

<div id="teacher" class="review hidden">
<strong>Paused · teacher review</strong>
<p class="help">The fuse is stopped. Approve only an answer that fits the category and has not already been used, including as a synonym. Approval passes the puffer and resumes the remaining time.</p>
<label for="ruling">Answer to review</label><input id="ruling" maxlength="100">
<div class="row" style="margin-top:12px"><button id="approve">Accept & pass</button><button id="resume" class="secondary">Resume</button></div>
<p id="reviewMessage" class="help" role="status"></p>
<hr><button id="quit" class="danger">End match & return to setup</button>
</div>
</div>

<aside class="card">
<h2>Teams & lives</h2><div id="roster"></div>
<hr><strong>Used this round</strong>
<p class="help">A synonym counts as the same answer. A repeat does not pass the puffer.</p>
<div id="used"></div>
<p class="fine">Lives determine survival. Accepted passes are also counted. Eliminated teams remain visible but are skipped.</p>
</aside>
</div>
</section>

<section id="end" class="card hidden">
<div class="tag">Last team in the reef</div><h2 id="winner"></h2>
<p id="endNote"></p><div id="endList"></div><button id="again" class="full">Play another match →</button>
</section>
<p class="fine">An original APES classroom game inspired by hot-potato category play. Not affiliated with Krillion or College Board. No student accounts required. Reduced-motion device settings are respected.</p>
</main>
